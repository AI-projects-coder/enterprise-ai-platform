FROM node:22-slim AS deps
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && pnpm config set store-dir /pnpm/store
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-slim AS build
WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
COPY --from=deps /pnpm /pnpm
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# API_INTERNAL_URL isn't needed at build time (only read server-side at
# request time via process.env), so no build-arg plumbing required here.
RUN pnpm build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# `output: "standalone"` (next.config.ts) produces a minimal server.js plus
# only the node_modules it actually traced as used — copy just that, not
# the full deps stage, which is the entire point of standalone output.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# Cloud Run injects $PORT (default 8080); Next's standalone server.js
# reads process.env.PORT directly, no -p flag needed.
CMD ["node", "server.js"]
